{
  "name": "archgraph",
  "version": "0.0.1",
  "description": "Interactive multi-perspective architecture diagrams from declarative YAML",
  "type": "module",
  "bin": {
    "archgraph": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "cli": "node dist/cli.js",
    "render": "node dist/cli.js render examples/ai-assistant.yaml -o out/ai-assistant.html --png",
    "test": "tsc && node --test test/smoke.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^12.1.0",
    "elkjs": "^0.9.3",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niclasedge/archgraph.git"
  }
}
